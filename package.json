  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@bridgetoagent-com/llms-txt-validator": "^0.1.0",
    "html-validate": "^11.16.0",
    "unlighthouse": "^0.18.0"
  }
}
