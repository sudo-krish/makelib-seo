{
  "name": "makelib-seo",
  "version": "0.1.0",
  "description": "A drop-in Makefile library for CI/CD pipelines enforcing Technical SEO, GEO, and Core Web Vitals",
  "main": "index.js",
  "bin": {
    "lychee": "bin/lychee.js"
  },
  "scripts": {
    "build": "echo 'makelib-seo: no compilation required'",
    "validate:html": "html-validate",
    "validate:llms": "llms-txt-validator ./llms.txt",
